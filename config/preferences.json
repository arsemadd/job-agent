{
  "roles": {
    "include": [
      "Product Manager", "Product Owner", "Technical Product Manager", "Associate Product Manager",
      "Product Operations", "Product Analyst", "Scrum Master", "QA Analyst", "QA Engineer",
      "Software QA", "QA Tester", "Test Analyst", "Test Engineer", "QA Automation",
      "Technical Program Manager", "Program Manager", "Delivery Manager", "Product/QA",
      "Business Analyst", "Implementation Manager", "Customer Success Manager"
    ],
    "exclude_keywords": [
      "Engineering Manager", "Software Engineer", "Backend Engineer", "Frontend Engineer",
      "Full Stack Engineer", "Data Scientist", "Data Engineer", "DevOps", "Sales Representative",
      "Account Executive", "Marketing Manager", "Recruiter", "Graphic Designer", "UX Designer",
      "Customer Support Representative"
    ],
    "defer_unknown_titles": false,
    "note": "include list is the title gate when defer_unknown_titles is false (recommended on Gemini free tier to avoid burning quota on noise). Set defer_unknown_titles true to also send ambiguous non-excluded titles to the AI."
  },

  "experience": {
    "minimum": 0,
    "target_min": 2,
    "target_max": 4,
    "soft_max": 6,
    "hard_reject_years": 7,
    "reject_seniority_titles": ["Senior", "Sr.", "Lead", "Principal", "Director", "VP", "Head of", "Staff"],
    "seniority_title_exceptions": ["Senior QA", "Sr. QA", "Senior Test", "QA Lead", "Test Lead"],
    "note": "hard_reject_years triggers automatic rejection at or above 7 years OR when a reject_seniority_title appears (unless it matches a seniority_title_exceptions pattern, e.g. 'Senior QA' is allowed through to AI judgment since QA seniority ladders differ from PM ones). 5-6 years required is NOT auto-rejected; it is passed to the AI matcher to judge whether responsibilities are realistic, and can come back as a lower-confidence SEND."
  },

  "location": {
    "priority_order": ["A_WORLDWIDE", "B_AFRICA_EMEA", "C_UNCLEAR", "D_REJECT"],
    "require_fully_remote": true,
    "reject_hybrid_onsite": true,
    "reject_work_authorization": true,
    "tier_a_worldwide_keywords": ["remote - worldwide", "remote - anywhere", "remote - global", "fully remote", "100% remote", "work from anywhere", "location independent", "remote (global)", "worldwide", "anywhere", "global"],
    "tier_b_africa_emea_keywords": [
      "remote - africa", "remote - emea", "africa timezone", "emea timezone",
      "kenya", "nigeria", "south africa", "ethiopia", "ghana", "egypt", "rwanda", "uganda", "tanzania",
      "emea", "gmt", "utc+1", "utc+2", "utc+3", "cet", "eet"
    ],
    "tier_d_reject_keywords": [
      "us only", "u.s. only", "usa only", "united states only", "must be located in the united states",
      "uk only", "united kingdom only", "eu only", "european union only", "canada only",
      "must be located in", "must reside in", "authorized to work in the us", "us citizen",
      "us work authorization required", "no visa sponsorship", "within the united states",
      "within the eu", "within canada", "within the uk", "latam only", "apac only",
      "remote - us", "remote (us)", "remote, us", "us remote", "remote us", "united states remote", "remote - united states", "remote (united states)",
      "remote - canada", "remote (canada)", "remote, canada", "canada remote", "remote canada",
      "remote - north america", "north america remote", "us/canada", "us or canada", "canada/us", "canada or us",
      "remote - uk", "remote (uk)", "remote, uk", "uk remote", "remote uk", "remote - united kingdom", "remote (united kingdom)", "london, united kingdom", "london, uk",
      "remote - europe", "remote (europe)", "remote, europe", "europe only", "eu only", "within europe",
      "remote - germany", "remote (germany)", "remote, germany", "germany only", "berlin, germany", "munich, germany",
      "remote - france", "remote, france", "remote - spain", "remote, spain", "remote - netherlands", "remote, netherlands",
      "remote - australia", "remote, australia", "remote - latam", "remote, latam", "remote - apac", "remote, apac", "remote - india",
      "canadian work authorization", "authorized to work in canada", "canadian citizen", "authorized to work in the uk", "eligible to work in the eu",
      "hybrid", "on-site", "onsite", "in-office", "office-based", "relocation required"
    ],
    "require_worldwide_for_alerts": true,
    "note": "Fully remote from anywhere only. US, Canada, UK, and region-restricted roles are hard-rejected. Discord alerts strictly require remote from anywhere / worldwide."
  },

  "job_type": {
    "accept": ["full-time", "contract", "full time"],
    "reject": ["part-time", "internship", "unpaid", "commission-only", "commission only"]
  },

  "language": {
    "reject_non_english_requirements": true,
    "note": "Hard-reject any posting that requires fluent, basic, native, conversational, or CEFR-level skill in a language other than English. English-only requirements pass. Bare language words without a proficiency/requirement signal are ignored to avoid false positives."
  },

  "scoring": {
    "min_score_to_send_digest": 65,
    "min_score_to_send_immediate": 85,
    "digest_range": [65, 84],
    "auto_reject_below": 65
  },

  "discord": {
    "send_immediate_at_or_above": 85,
    "send_digest_between": [65, 84],
    "digest_schedule": "batched each scheduled run"
  },

  "company_quality": {
    "reject_generic_company_names": ["confidential", "stealth", "our client", "a client", "n/a", "undisclosed"],
    "require_apply_link": true
  },

  "sources": {
    "enabled": [
      "remoteok",
      "remotive",
      "weworkremotely",
      "himalayas",
      "mindtheproduct",
      "arbeitnow",
      "jobicy",
      "workingnomads",
      "remotefirstjobs",
      "nodesk",
      "jobspresso",
      "fourdayweek",
      "remotewoman",
      "aijobs",
      "jsremotely",
      "remoterocketship",
      "greenhouse",
      "lever",
      "ashby"
    ],
    "manual_imports": [
      {"name": "wellfound", "file": "data/wellfound_manual.json"},
      {"name": "thesaasjobs", "file": "data/thesaasjobs_manual.json"},
      {"name": "startupjobs", "file": "data/startupjobs_manual.json"}
    ],
    "disabled_pending_manual_setup": ["wellfound", "thesaasjobs", "startupjobs"],
    "discovery_only": [
      "flexjobs",
      "toptal",
      "jobfill",
      "workwave"
    ],
    "greenhouse_boards": [
      "intercom",
      "miro",
      "duolingo",
      "calendly",
      "gitlab",
      "hashicorp"
    ],
    "lever_companies": [
      "netflix",
      "spotify",
      "shopify"
    ],
    "ashby_companies": [
      "notion",
      "linear",
      "ramp",
      "vercel"
    ],
    "note": "Live collectors need no setup. remoterocketship needs REMOTE_ROCKETSHIP_API_KEY for live fetch (otherwise skips). Manual boards (Wellfound, The SaaS Jobs, Startup Jobs) read data/*_manual.json. FlexJobs/Toptal/JobFill/WorkWave are discovery-only (paid, gated, or not a job board)."
  },

  "schedule": {
    "runs_local_time": "every hour (UTC cron; Nairobi = UTC+3)",
    "timezone": "Africa/Nairobi",
    "cron_utc": "0 * * * *"
  }
}
