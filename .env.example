# Copy this file to .env for local runs (GitHub Actions uses repo Secrets instead - see README).

# Which AI backend scores jobs. "gemini" = Google's free tier ($0). "anthropic" = Claude (paid, cheap).
AI_PROVIDER=gemini

# Required if AI_PROVIDER=gemini - free key, no billing needed to start: https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# Optional override - check https://ai.google.dev/gemini-api/docs/pricing for the current free-tier model list
# GEMINI_MODEL=gemini-3.5-flash-lite

# Required if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Required - where SEND/DIGEST notifications get posted
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional Discord behavior
# Webhook targets a forum channel — set DISCORD_FORUM=1 (or leave unset; auto-detected on 220001).
DISCORD_FORUM=1
# DISCORD_THREAD_ID=
# DISCORD_THREAD_NAME=
# Post a short run heartbeat even when no matches (default on)
DISCORD_NOTIFY_EMPTY_RUNS=1

# Optional
# LOG_LEVEL=INFO
# MAX_SCORE_PER_RUN=40
